<style>
  @media (max-width: 768px) {
    .mobile-hidden {
      display: none !important;
    }
  }

  @media (min-width: 768px) {
    .desktop-hidden {
      display: none !important;
    }
  }
</style>

<div>
  <h2 class="ui left floated inverted header">Manage Galeries</h2>
  <a class="ui inverted basic button asdf" href="/admin/galery/new">
    <i class="plus icon"></i>
    Create new
  </a>

  <!-- Mobile ONLY -->
  <div class="desktop-hidden" style="padding:0 1rem; width:100%; display:flex; flex-direction:column; color:white;">
    {{#each galeries}}
    <div style="
    display:flex;
    flex-flow:row wrap;
    justify-items:left;
    flex-direction:row;
    padding:2rem 0;
    row-gap:0.75rem;
    border-bottom:1px white solid;" id="galery_{{this._id}}" class="galery-listing">
      <div style="flex-basis:50%;flex-grow:1;" class="ui inverted first header">{{this.title}}</div>
      <div style="text-align:right;">{{formatDate this.dateOfPlay}}</div>
      <div style="flex-basis:100%;">Location: {{this.location}}</div>
      <div>Tags: {{this.tags}}</div>

      <div style="flex-basis:100%;" id="gallery_{{this._id}}_displayed" data-id="{{this._id}}" class="ui toggle checkbox isFavorite">
        <input type="checkbox" data-id="{{this._id}}" tabindex="0" name="isFavorite" class="hidden visible" {{#if
          this.isFavorite}}checked{{/if}}>    
         <label class="">Show on home screen</label>
      </div>

      <div style="flex-basis:100%;" id="gallery_{{this._id}}_active" data-id="{{this._id}}" class="ui toggle checkbox isActive">
        <input type="checkbox" data-id="{{this._id}}" tabindex="0" name="isActive" class="hidden visible" {{#if
          this.isActive}}checked{{/if}}>
         <label>Is active</label>
      </div>

      <div>
        {{> admin/gallery-actions this}}
      </div>
    </div>
    {{/each}}
  </div>

  <!-- Desktop ONLY -->
  <table class="ui inverted table mobile-hidden">
    <thead>
      <tr>
        <th>Título</th>
        <th>Fecha</th>
        <th>Time</th>
        <th>Director(a)</th>
        <th>Etiquetas</th>
        <th>Displayed</th>
        <th>Active</th>
        <th style="min-width:125px;">Actions</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <div class="ui list clearfix"></div>
      {{#each galeries}}
      <tr id="galery_{{this._id}}" class="galery-listing">
        <td>{{this.title}}</td>
        <td>{{formatDate this.dateOfPlay}}</td>
        <td>{{getTime this.dateOfPlay}}</td>   
        <td>{{this.location}}</td>
        <td>{{this.tags}}</td>
        <td>
          <div id="gallery_{{this._id}}_displayed" data-id="{{this._id}}" class="ui toggle checkbox isFavorite">
            <input type="checkbox" data-id="{{this._id}}" tabindex="0" name="isFavorite" class="hidden visible" {{#if
              this.isFavorite}}checked{{/if}}>
          </div>
        </td>
        <td>
          <div id="gallery_{{this._id}}_active" data-id="{{this._id}}" class="ui toggle checkbox isActive">
            <input type="checkbox" data-id="{{this._id}}" tabindex="0" name="isActive" class="hidden visible" {{#if
              this.isActive}}checked{{/if}}>
          </div>
        </td>
        <td style="white-space:nowrap;">
           {{> admin/gallery-actions this}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Delete Modal -->
  <div class="ui basic modal confirm delete" id="deleteModalTemplate">
    <i class="close icon"></i>
    <div class="header">
      Bestätigung Löschvorgang
    </div>
    <div class="image content">
      <div class="image">
        <i class="archive icon"></i>
      </div>
      <div class="description">
        <p>Are you sure to delete ###placeholder###?</p>
      </div>
    </div>
    <div class="actions">
      <div class="two fluid ui inverted buttons">
        <div class="ui deny red basic inverted button">
          <i class="remove icon"></i>
          Cancel
        </div>
        <div class="ui approve green basic inverted button">
          <i class="checkmark icon"></i>
          Yes, I want to delete ###placeholder###!
        </div>
      </div>
    </div>
  </div>
</div>